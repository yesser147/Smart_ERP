# Copy to backend/.env and fill in. Read by application.yaml.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_erp
DB_USER=postgres
DB_PASSWORD=change-me

# Password of the chatbot's read-only role (created by R__create_bi_views.sql).
# Must be identical to AI_DB_PASSWORD in ai_engine/.env
AI_DB_PASSWORD=change-me

# Gmail address + app password (Google account > Security > App passwords)
MAIL_USERNAME=your.account@gmail.com
MAIL_PASSWORD=change-me

# Base64 key, at least 32 bytes. Generate one with:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(64)).decode())"
# Must be identical to JWT_SECRET in ai_engine/.env
JWT_SECRET=change-me

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me

# First administrator (created at the first start). Change the password!
ADMIN_EMAIL=admin@smarterp.com
ADMIN_PASSWORD=change-me

# Optional
# SHOW_SQL=true
# AI_SERVICE_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:4200
