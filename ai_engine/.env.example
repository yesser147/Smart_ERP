# Copy to ai_engine/.env and fill in.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_erp
DB_USER=postgres
DB_PASSWORD=change-me

# Read-only role used by the chatbot's generated SQL (created by the backend's
# R__create_bi_views.sql). Must match AI_DB_PASSWORD in backend/.env
AI_DB_USER=ai_readonly_user
AI_DB_PASSWORD=change-me

# Must be identical to JWT_SECRET in backend/.env
JWT_SECRET=change-me

# LLMs
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
# groq = Groq first, Ollama as fallback | ollama = local only
LLM_PROVIDER=groq
OLLAMA_MODEL=llama3.1

# Private MinIO bucket holding the CV PDFs
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:4200
